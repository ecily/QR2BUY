# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Database — placeholders only
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.invalid/qr2buy

# Public origins
PUBLIC_BASE_URL=https://qr2buy.com
CORS_ORIGIN=https://qr2buy.com

# Existing administration and checkout — placeholders only
ADMIN_USER=replace-me
ADMIN_PASS=replace-me
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Session-isolated live demo — Stripe sandbox only
STRIPE_DEMO_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_DEMO_WEBHOOK_SECRET=whsec_REPLACE_WITH_PUBLIC_SANDBOX_WEBHOOK_SECRET
DEMO_PUBLIC_BASE_URL=https://qr2buy.com
DEMO_SESSION_TTL_MINUTES=120

# Optional physical hardware binding for the session-isolated demo.
# Use a random operator secret, a 64-character random hex key, and a JSON map of device secrets.
DEMO_HARDWARE_PAIRING_SECRET=replace-with-random-operator-secret
DEMO_HARDWARE_ENCRYPTION_KEY=replace-with-64-random-hex-characters
DEMO_HARDWARE_DEVICE_SECRETS={"demo-device":"replace-with-random-device-secret"}

# Optional demo mail. Keep disabled unless every SMTP field is configured.
DEMO_MAIL_TRANSPORT=disabled
DEMO_SMTP_HOST=smtp.example.invalid
DEMO_SMTP_PORT=465
DEMO_SMTP_USER=replace-me
DEMO_SMTP_PASS=replace-me
DEMO_SMTP_FROM=demo@example.invalid
DEMO_SMTP_HELO_NAME=qr2buy.com
# Explicit safety gates for the non-destructive local merchant demo seed.
MERCHANT_DEMO_SEED_ENABLED=false
MERCHANT_DEMO_SEED_ALLOW_PRODUCTION=false
# Merchant devices: independent 32-byte random pepper, encoded as 64 hex characters.
# Required only for the new /api/device/config authentication, never the demo.
DEVICE_CREDENTIAL_PEPPER=
# Internal binding pilot only: server-fixed merchant scope; empty disables operator endpoints.
# Uses existing ADMIN_USER/ADMIN_PASS, never distribute these as merchant accounts.
BINDING_OPERATOR_MERCHANT_ID=
# Product-code backfill is a separate explicit command, never application startup.
BINDING_CODE_MIGRATION_ENABLED=false
BINDING_CODE_MIGRATION_ALLOW_PRODUCTION=false
